# Use the NVIDIA CUDA base image
FROM nvidia/cuda:12.0.0-devel-ubuntu22.04

# Install common dependencies and netlib
COPY --from=base:latest /usr /usr

# Install common dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    wget \
    git \
    unzip \
    python3 \
    python3-pip \
    libnuma-dev \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for CUDA
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

# Clone the Intel LLVM repository
RUN wget https://github.com/intel/llvm/archive/refs/heads/sycl.zip && unzip sycl.zip

# Build the DPC++ toolchain with CUDA support
RUN mkdir -p /llvm-sycl/build && cd /llvm-sycl/build \
    && cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_ENABLE_PROJECTS="clang;compiler-rt" \
        -DLLVM_TARGETS_TO_BUILD="X86;NVPTX" \
        -DSYCL_BUILD_PI_CUDA=ON \
        -DCUDA_TOOLKIT_ROOT_DIR=$CUDA_HOME \
        /llvm-sycl/llvm \
    && make -j$(nproc)

# Set environment variables for DPC++
ENV DPCPP_HOME=/llvm/build
ENV PATH=$DPCPP_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$DPCPP_HOME/lib:$LD_LIBRARY_PATH

# Verify installation
RUN clang++ --version && clang++ -fsycl -fsycl-targets=nvptx64-nvidia-cuda-sycldevice --cuda-path=$CUDA_HOME --cuda-gpu-arch=sm_50 -x cuda -c /llvm/sycl/test/basic_tests/simple_kernel.cpp -o /dev/null

# Set the working directory
WORKDIR /app

# Copy the project files
COPY . .

# Build and install the project
RUN "mkdir -p build && cd build && cmake .. && make -j$(nproc) && make install"

# Default command
CMD ["/bin/bash"]
